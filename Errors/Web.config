<?xml version="1.0"?>
<configuration>
  <system.web>
    <!-- The error page must open without a login: otherwise an error on the login page (e.g. the database is down)
         sends the user to Login again, which fails again, and ASP.NET shows "another exception occurred while
         executing the custom error page" -->
    <authorization>
      <allow users="*"/>
    </authorization>
  </system.web>
</configuration>
