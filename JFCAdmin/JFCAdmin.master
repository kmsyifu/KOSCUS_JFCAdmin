<%@ Master Language="VB" AutoEventWireup="false" CodeFile="JFCAdmin.master.vb" Inherits="JFCAdmin_JFCAdmin" %>
<%@ Import Namespace="Common" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="ajaxToolkit" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head id="Head1" runat="server">
    <title></title>
    <link href="~/Styles/Site.css?v=<%= Common.VERSION %>d" rel="stylesheet" type="text/css" />
    <link href="~/Styles/Koscus.css?v=<%= Common.VERSION %>d" rel="stylesheet" type="text/css" />
    <link href="~/Styles/jquery-ui-1.8.16.custom.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/jquery.autocomplete.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/dropdown.css" rel="stylesheet" type="text/css" />
    <%--Favicon--%>
    <link rel="shortcut icon" href="~/Images/Web/jfc-icon.ico" />

    <asp:ContentPlaceHolder ID="DefContent" runat="server">
        <script src="<%= ResolveClientUrl("~/Scripts/jquery-1.8.3.min.js") %>" type="text/javascript"></script>
        <script src="https://code.jquery.com/ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
      <%--  <script src="<%= ResolveClientUrl("~/Scripts/jquery-ui-1.8.16.custom.min.js") %>" type="text/javascript"></script>--%>
        <script src="<%= ResolveClientUrl("~/Scripts/Common.js?v=" & Common.VERSION) %>" type="text/javascript"></script>
        <script src="<%= ResolveClientUrl("~/Scripts/jquery.autocomplete.js?v=" & Common.VERSION) %>" type="text/javascript"></script>
        <%--<link rel="stylesheet" href="https://code.jquery.com/ui/1.9.2/themes/base/jquery-ui.css">--%>
        <script type="text/javascript">
            var SystemDialogMessage = '';
            var SystemDialogTitle = '';
            var SystemDialogReturnURL = '';
            var SystemDialogButton = '';
            var SystemLineMessage = '';
            var SystemLineType = '';
            <%= GetJavaScript()%>
            <%= JavaScript2 %>
        </script>
    </asp:ContentPlaceHolder>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="body">
    <form id="Form1" runat="server">
    <input type="hidden" id="DialogResult" name="DialogResult" value="" />
    <ajaxToolkit:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server"></ajaxToolkit:ToolkitScriptManager>
  
    <div class="page">
        <%--<div id="divPageMsg_top" style="visibility:hidden;"></div>
        <div id="divPageMsg_btm" style="visibility:hidden;"></div>--%>
        <div class="headerTop">
            <%--<h1>JFCWeb</h1>--%>
            <%--<img alt="" src="<%= ResolveClientUrl("~/Images/Web/jfcLogo.gif") %>" />--%><%--Cannot use GetWebImgUrl() here--%>
            <img alt="" src="<%= ResolveClientUrl("~/Images/Web/jfcLogo.png") %>" height="35px" />
            <div id="divHdrLink" class="hdrLink">
                <%--<asp:ImageButton ID="btnUser" CssClass="xsImgBtn" runat="server" ImageUrl="~/Images/Web/user.png" PostBackUrl="~/JFCAdmin/MyAccount.aspx" />
                <asp:LinkButton ID="lnkUser" runat="server" Text="My Account" PostBackUrl="~/JFCAdmin/MyAccount.aspx" />&nbsp;&nbsp;--%>
                <asp:Image ID="imgUser" CssClass="xsImgBtn" runat="server" ImageUrl="~/Images/Web/user.png" />
                <asp:Label ID="lblUser" runat="server" />&nbsp;&nbsp;
                <%--<asp:ImageButton ID="btnSwitchUserType" CssClass="xsImgBtn" runat="server" ImageUrl="~/Images/Web/users.png" PostBackUrl="~/Login/LoginType.aspx" />
                <asp:LinkButton ID="lnkSwitchUserType" runat="server" Text="Switch Account" PostBackUrl="~/Login/LoginType.aspx" />&nbsp;&nbsp;--%>
                <asp:ImageButton ID="btnLogout" CssClass="xsImgBtn" runat="server" ImageUrl="~/Images/Web/lock.png" PostBackUrl="~/Login/Login.aspx" />
                <asp:LinkButton ID="lnkLogout" runat="server" Text="Log Out" PostBackUrl="~/Login/Login.aspx" />&nbsp;&nbsp;
            </div>
         </div>
        <div class="menubar">
            <ul class="dropdown">
                <li><a runat="server" id="aHome" href="~/JFCAdmin/Home.aspx" onclick="showProgress();">Home</a></li>
                <li><a runat="server" id="aOrderHistory" href="~/JFCAdmin/OrderHistory.aspx" onclick="showProgress();">Orders</a></li>
                <%--<li><a runat="server" id="aDeliverySched" href="~/JFCAdmin/CustSetting.aspx" onclick="showProgress();">Delivery Schedule</a></li>--%>
                <asp:Panel ID="pnlCustSetting" runat="server">
                 <li><a runat="server" id="aCustSetting" href="~/JFCAdmin/CustSetting.aspx" onclick="showProgress();">Customer Settings</a></li>
                </asp:Panel>
               
                  <asp:Panel ID="pnlCustItem" runat="server">
                    <li><a runat="server" id="aCustItem" href="~/JFCAdmin/CustItem.aspx" onclick="showProgress();">Customer Items </a></li>
                </asp:Panel>
                 <asp:Panel ID="pnlBranchSetting" runat="server">
                    <li><a runat="server" id="aBranchSetting" href="~/JFCAdmin/BranchSetting.aspx" onclick="showProgress();">Branch Settings </a></li>
                </asp:Panel>
                <asp:Panel ID="pnlTool" runat="server">
                    <li><a runat="server" id="aTool" href="~/JFCAdmin/Tool.aspx" onclick="showProgress();">Tools </a></li>
                </asp:Panel>
                <%--<asp:Panel ID="pnlJFCAdmin" runat="server">
                    <li><a runat="server" id="aJFCAdmin" href="~/JFCAdmin/JFCAdmin.aspx" onclick="showProgress();">JFC Settings (D)</a></li>
                </asp:Panel>
                <asp:Panel ID="pnlCustAdmin" runat="server">
                    <li><a runat="server" id="aCustAdmin" href="~/JFCAdmin/CustAdmin.aspx" onclick="showProgress();">Customer Settings (D)</a></li>
                </asp:Panel>--%>
              
                <%--<asp:Panel ID="pnlPayment" runat="server"> 
                    <li><a runat="server" id="aBalance" href="~/JFCAdmin/Balance.aspx" onclick="showProgress();">Payment</a></li>
                </asp:Panel>--%>
                <%--<li><a runat="server" id="aMyAccount" href="~/JFCAdmin/MyAccount.aspx">My Account</a></li>--%>
            </ul>
        </div>
        <div class="main turnOffFloat">
            <%--Show progress popup during postback--%>
            <script type="text/javascript">
                $('form').live("submit", function () {

                    if (DoPageClientValidate("validgroup") && DoPageClientValidate("validgroupUser") && DoPageClientValidate("validgroupCompany") && DoPageClientValidate("Homepageupload")) {
                        showProgress();
                    }
                

                });
                function DoPageClientValidate(validationGroupName) {
                    var result = Page_ClientValidate(validationGroupName);
                    Page_BlockSubmit = false;
                    return result;
                }
            </script>
            <div class="loading popup_dialog" >
                <h1><label>Processing</label></h1>
                <p><img alt="" class="mImgBtn" src="<%= ResolveClientUrl("~/Images/Web/progress.gif") %>" />&nbsp;&nbsp;
                    <label>Please wait...</label></p>
            </div>

            <%--Show content--%>
            <asp:ContentPlaceHolder ID="MainContent" runat="server"/>
        </div>
        <div class="footer">
            <p>Copyright (c) <asp:Label ID="Label1" Text='<%# Common.CURRENT_YEAR %>' runat="server" /> JFC International, Inc.・<asp:LinkButton runat="server" id="lnkMobileSite" Visible='<%# Common.ENABLE_MOBILE_VERSION %>' Cssclass='linkcolor' Text="Mobile Site・" /><a runat="server" id="a15" class='linkcolor' href="~/Common/ShowFile.aspx?name=PrivacyPolicy.pdf" target="_blank">Privacy Policy</a></p>
            <%--<a target="_blank" class='linkcolor' href='http://shop.jfc.com/Login/PrivacyPolicy.htm'>Privacy Policy</a>--%>
        </div>
    </div>
    </form>
</body>
</html>
