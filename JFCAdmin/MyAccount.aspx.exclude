<%@ Page Language="VB" MasterPageFile="JFCAdmin.master" AutoEventWireup="false" CodeFile="MyAccount.aspx.vb" Inherits="JFCAdmin_MyAccount" %>
<%@ Register Tagprefix="uc" Tagname="MyAccount" Src="~/Common/MyAccount.ascx" %>
<%@ Import Namespace="Common" %>

<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" Runat="Server">
    <script type="text/javascript">
        $(document).ready(function () {
            $("#tabs").tabs();
            $("#tabs").removeClass("ui-widget");
            $('#tabs').css('display', 'block'); //Display tabs when page finish loading
            <%= JavaScript %>
        });
    </script>

    <h1>My Account</h1>

    <div id="tabs" style="display: none;"> <%--Display tabs when page finish loading--%>
        <ul>
            <li><a href="#tabUserAcc">User Account</a></li>
            <%--<li><a href="#tabPaymentAccc">Payment Account</a></li>--%>
        </ul>

        <uc:MyAccount id="ctrMyAccount" runat="Server" />
     </div>
</asp:Content>
