    Private Sub showCustCompanyList()
        Dim SQL As String

        Using DB As New DBHelper
            'Show customer company list
            pnlList_custCompany.Visible = True
            pnlDtl_custCompany.Visible = False

            SQL = "SELECT c.*, " & _
                    " (SELECT codeDesc FROM codemaster WHERE codeGrp = 'CUSTCOMPANY_TYPE' AND code_id = c.type_id) AS type " & _
                    "FROM custCompany c"
            dsCustCompany.ProviderName = "System.Data.OracleClient"
            dsCustCompany.ConnectionString = DB.GetConnectionString
            dsCustCompany.SelectCommand = SQL
            grdCustCompany.DataSourceID = "dsCustCompany"
            grdCustCompany.Sort("CUSTCOMPANYNAME", SortDirection.Ascending)
            grdCustCompany.DataBind()
        End Using

    End Sub

