    Private Sub showJfcBranchList()
        Dim SQL As String

        Using DB As New DBHelper
            'Show JFC branch list
            pnlList_jfcBranch.Visible = True
            pnlDtl_JfcBranch.Visible = False

            SQL = "SELECT * FROM jfcVendor "
            dsJfcBranch.ProviderName = "System.Data.OracleClient"
            dsJfcBranch.ConnectionString = DB.GetConnectionString
            dsJfcBranch.SelectCommand = SQL
            grdJfcBranch.DataSourceID = "dsJfcBranch"
            grdJfcBranch.Sort("VENDORNAME", SortDirection.Ascending)
            grdJfcBranch.DataBind()
        End Using
    End Sub

