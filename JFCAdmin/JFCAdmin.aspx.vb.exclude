    '--------------------------------------------------------------------------------------------------------------------
    'Common routine
    '--------------------------------------------------------------------------------------------------------------------
    Private Sub setJavaScript(ByVal tab As JfcAdmin_Tab)
        JavaScript = "$('#tabs').tabs('select', " & tab & ");"
    End Sub

    Private Sub setSubJavaScript(ByVal subtab As Integer, ByVal curTab As JfcAdmin_Tab)
        Select Case curTab
            Case JfcAdmin_Tab.USERACC
                JavaScript = "$('#subtabs_userAcc').tabs('select', " & subtab & ");"
                'Case CustAdmin_Tab.CUSTGRP
                '    JavaScript = "$('#subtabs_custGrp').tabs('select', " & subtab & ");"
        End Select
    End Sub

