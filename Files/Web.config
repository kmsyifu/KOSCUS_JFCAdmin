<?xml version="1.0"?>
<!--
  Files\ holds uploaded / generated files only. Nothing in it may run as code:
  accessPolicy="Read" turns off every script handler (.aspx, .ashx, .asmx, .asp, ...) for this folder and below,
  so a file that gets in here is at most downloaded, never executed. Static files (images, .xls, .pdf) still work.
-->
<configuration>
  <system.webServer>
    <handlers accessPolicy="Read" />
  </system.webServer>
</configuration>
