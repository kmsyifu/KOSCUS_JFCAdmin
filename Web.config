<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="businessObjects">
      <sectionGroup name="crystalReports">
        <section name="rptBuildProvider" type="CrystalDecisions.Shared.RptBuildProviderHandler, CrystalDecisions.Shared, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304, Custom=null"/>
      </sectionGroup>
    </sectionGroup>
  </configSections>
  <system.web>
    <!--<httpRuntime requestValidationMode="2.0" />--><!--Uncomment out if setting validateRequest="false"-->
    <!--<customErrors mode="Off"/>-->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Errors/Error.aspx"/> <!--Always set a custom error page-->
    <compilation strict="false" explicit="true" targetFramework="4.0" debug="true"><!--Use debug="true" for release mode as well so that detail message can be sent when an error occurs-->
      <assemblies>
        <add assembly="System.Data.OracleClient, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Web.Extensions.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>       
        <add assembly="AjaxControlToolkit, Version=4.1.60919.0, Culture=neutral, PublicKeyToken=28f01b0e84b6d53e"/><!--Add by jzhou-->
      </assemblies>
      <buildProviders>
        <add extension=".rpt" type="CrystalDecisions.Web.Compilation.RptBuildProvider, CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
      </buildProviders>
    </compilation>
	  <!--httpHandlers>
		  <add verb="*" path="AjaxFileUploadHandler.axd"
			type="AjaxControlToolkit.AjaxFileUploadHandler,
          AjaxControlToolkit"/>
	  </httpHandlers-->
	  
    <!--Add by jzhou-->
    <httpCookies httpOnlyCookies="true" requireSSL="false" /> <!--Always pass a secure cookie. Better to set requireSSL="true" but doesn't work in localhost-->
    <sessionState mode="StateServer" cookieless="false" timeout="120"/><!--INFO: mode="InProc" will store sessions inside memory of your application. When application pool expires, session times out. Use "StateServer" instead to avoid timeout--> 
    <!--INFO: Maintain a session state per browser tab--><!--INFO: Use cookieless session and in particular embed session identifying code into the URI-->
    <!--<sessionState mode="InProc" cookieless="true" regenerateExpiredSessionId="true" timeout="120"/>--><!--Not recommended-->
    <!--Add End-->
    <authentication mode="Forms">
      <!--<forms loginUrl="~/Login/Login.aspx" timeout="60" slidingExpiration="true" cookieless="UseCookies"/>-->
      <forms loginUrl="~/Login/Login.aspx" timeout="120" slidingExpiration="true"/><!--Mod by jzhou-->
    </authentication>
    <authorization>
      <allow users="u"/>
      <deny users="?"/>
    </authorization>
	
    <!--<pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID"/> -->
    <!--Add by jzhou-->
    <machineKey validationKey="AutoGenerate" decryptionKey="AutoGenerate" validation="SHA1"/><!--Used to encrypt Viewstate-->
    <pages maintainScrollPositionOnPostBack="true" viewStateEncryptionMode="Always"><!--Store scroll position--><!--Encrypt Viewstate-->
      <controls>
        <add tagPrefix="ajaxToolkit" namespace="AjaxControlToolkit" assembly="AjaxControlToolkit, Version=4.1.60919.0, Culture=neutral, PublicKeyToken=28f01b0e84b6d53e"/>
      </controls>
    </pages>
    <!--Trace pages (Make sure Trace is not enabled)-->
    <!--<trace enabled="true" pageOutput="true" requestLimit="40" localOnly="false"/>-->
    <!--End Add by jzhou-->
	  
  </system.web>  
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
	  <validation validateIntegratedModeConfiguration="false"/>
	  <handlers>
		  <add name="AjaxFileUploadHandler" verb="*" path="AjaxFileUploadHandler.axd" type="AjaxControlToolkit.AjaxFileUploadHandler, AjaxControlToolkit"/>
	  </handlers>
	  <security>
		  <requestFiltering>
			  <requestLimits maxAllowedContentLength="4294967295"/>
		  </requestFiltering>
	  </security>
	  <!--Add by jzhou-->
    <!--INFO: Redirect from http to https automatically. Only redirect for shop.jfc.com-->
    <!--TODO: Uncomment out when releasing; otherwise, http://10.0.201.104/KOSCUS_JFCAdmin/Login/Login.aspx cannot be accessed-->
    <!--<rewrite>
      <rules>
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="shopadmin\.jfc\.com" />
          </conditions>
          <action type="Redirect" redirectType="Found" url="https://{HTTP_HOST}/{R:1}" />
        </rule>
      </rules>
    </rewrite>-->
    <!--Add End-->
  </system.webServer>
  <businessObjects>
    <crystalReports>
      <rptBuildProvider>
        <add embedRptInResource="true"/>
      </rptBuildProvider>
    </crystalReports>
  </businessObjects>
  <appSettings/>
  <!--Used for Paymentsgateway-->
  <system.serviceModel>
    <bindings/>
    <client/>
  </system.serviceModel>
</configuration>